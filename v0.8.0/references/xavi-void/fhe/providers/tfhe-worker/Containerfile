FROM docker.io/library/rust:1.91.1-bookworm AS tfhe-build
WORKDIR /tfhe
COPY providers/tfhe-rs-split/Cargo.toml Cargo.toml
COPY providers/tfhe-rs-split/src src
RUN cargo build --release --bin xvoid-tfhe-evaluator

FROM docker.io/library/python:3.13-slim-bookworm
RUN useradd --system --uid 10001 --create-home xvoid && mkdir -p /keys /app && chown -R xvoid:xvoid /keys /app
COPY . /src/xavi-void
RUN pip install --no-cache-dir /src/xavi-void && rm -rf /root/.cache /src/xavi-void/.git
COPY --from=tfhe-build /tfhe/target/release/xvoid-tfhe-evaluator /usr/local/bin/xvoid-tfhe-evaluator
USER xvoid
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python","-m","xavi_void.runtime.worker_sidecar"]
CMD ["--evaluator-command","/usr/local/bin/xvoid-tfhe-evaluator --server-key /keys/server-key.bin --device cpu"]
