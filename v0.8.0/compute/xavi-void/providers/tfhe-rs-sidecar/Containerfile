# Build inside the container: no Rust/Cargo installation is required on the host.
FROM docker.io/library/rust:1.91.1-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.toml
COPY src src
RUN cargo build --release --features cpu

FROM docker.io/library/debian:bookworm-slim
RUN useradd --system --uid 10001 --create-home xvoid
COPY --from=build /src/target/release/xavi-void-tfhe-sidecar /usr/local/bin/xavi-void-tfhe-sidecar
USER xvoid
ENTRYPOINT ["/usr/local/bin/xavi-void-tfhe-sidecar"]
CMD ["--device","cpu"]
