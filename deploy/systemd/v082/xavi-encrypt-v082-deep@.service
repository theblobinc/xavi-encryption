[Unit]
Description=XAVI-DUO v0.8.2 authenticated recipient recovery audit (%i)
Documentation=https://github.com/theblobinc/xavi-encryption
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -I /usr/local/libexec/xavi-encrypt-v082-audit.py --profile %i --deep
TimeoutStartSec=150
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LockPersonality=yes
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
