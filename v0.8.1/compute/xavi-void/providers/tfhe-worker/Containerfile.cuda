# Production-3 currently uses an R535 NVIDIA driver, so keep this worker on CUDA 12.x.
FROM docker.io/nvidia/cuda:12.2.2-devel-ubuntu22.04 AS tfhe-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl ca-certificates pkg-config libssl-dev clang libclang-dev python3 python3-pip \
    && python3 -m pip install --no-cache-dir 'cmake>=3.24,<4' \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain 1.91.1
ENV PATH=/root/.cargo/bin:$PATH
WORKDIR /tfhe
COPY providers/tfhe-rs-split/Cargo.toml Cargo.toml
COPY providers/tfhe-rs-split/src src
RUN cargo build --release --features cuda --bin xvoid-tfhe-evaluator

FROM docker.io/nvidia/cuda:12.2.2-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home xvoid && mkdir -p /keys /app && chown -R xvoid:xvoid /keys /app
COPY . /src/xavi-void
RUN python3 -m pip install --no-cache-dir /src/xavi-void && rm -rf /root/.cache /src/xavi-void/.git
COPY --from=tfhe-build /tfhe/target/release/xvoid-tfhe-evaluator /usr/local/bin/xvoid-tfhe-evaluator
USER xvoid
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python3","-m","xavi_void.runtime.worker_sidecar"]
CMD ["--evaluator-command","/usr/local/bin/xvoid-tfhe-evaluator --server-key /keys/server-key.bin --device cuda"]
