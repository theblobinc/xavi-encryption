FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates libgomp1 && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --break-system-packages --no-cache-dir openfhe
RUN useradd --system --uid 10001 --create-home xvoid
WORKDIR /app
COPY sidecar.py /app/sidecar.py
RUN chmod 0555 /app/sidecar.py
USER xvoid
ENTRYPOINT ["python3","/app/sidecar.py"]
